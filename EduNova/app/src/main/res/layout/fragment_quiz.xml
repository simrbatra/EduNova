<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="16dp">

	<TextView
		android:id="@+id/text_selected_subject"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Math"
		android:textStyle="bold"
		android:textSize="18sp" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginTop="8dp">

		<Button
			android:id="@+id/btn_subject_math"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Math" />

		<Button
			android:id="@+id/btn_subject_science"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Science" />

		<Button
			android:id="@+id/btn_subject_english"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="English" />

	</LinearLayout>

	<Button
		android:id="@+id/btn_start_quiz"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:text="Start 10-question Quiz" />

	<LinearLayout
		android:id="@+id/questions_container"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:layout_marginTop="16dp" />

	<Button
		android:id="@+id/btn_submit_quiz"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:text="Submit Answers"
		android:visibility="gone" />

</LinearLayout>


